# Server Configuration
PORT=5000

# MongoDB Connection String
# Replace <username> and <password> with your Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/boardroom_db?retryWrites=true&w=majority

# Optional Default Administrator Credentials
# (Auto-seeded if no administrator exists in the database)
ADMIN_EMAIL=admin@tasmagroup.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator
ADMIN_EMP_ID=ADM-001
ADMIN_DEPT=IT Department
